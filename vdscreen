#!/bin/zsh
# vdscreen — macOS 虚拟显示器管理
#
#   vdscreen on [宽x高] [名字]   启动虚拟屏（可临时覆盖尺寸/名字）
#   vdscreen off                 关闭
#   vdscreen restart             重启
#   vdscreen status              查看状态（不带参数时的默认动作）
#   vdscreen presets             列出预设分辨率
#   vdscreen preset <名字>       按预设启动（如: vdscreen preset "iPad mini 7"）
#   vdscreen rotate              横竖切换（交换当前宽高）
#   vdscreen state               机器可读状态: "on <名字> <宽x高>" 或 "off"
#   vdscreen config              查看配置文件
#   vdscreen set size 1133x744   改默认尺寸
#   vdscreen set name "iPad mini 7"
#   vdscreen install             装到 ~/bin，之后任意目录可用
#   vdscreen uninstall           停止并移除 ~/bin 里的命令
#
# 显示器与创建它的进程同生命周期，由 LaunchAgent 托管。
# 只要 plist 存在，登录后会自动拉起；off 会移除 plist，确保关闭后不再自动启动。

set -euo pipefail

CONFIG_DIR="$HOME/.config/vdscreen"
CONFIG="$CONFIG_DIR/config"
PRESETS="$CONFIG_DIR/presets"
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"

# 默认值；~/.config/vdscreen/config 里的同名变量会覆盖它们。
# 改 LABEL 可以并存多块虚拟屏（Each label = one agent = one screen）。
LABEL="com.local.vdscreen.ipadmini7"
CORE="$SELF_DIR/vdscreen-core"
NAME="iPad mini 7"
SIZE="1133x744"

[[ -f "$CONFIG" ]] && source "$CONFIG"

# 必须在读取配置之后计算，否则配置里改 LABEL 会失效
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"

say()  { print -r -- "$@" }
die()  { print -ru2 -- "错误: $@"; exit 1; }
loaded() { launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; }

current_pid() {
  launchctl print "$DOMAIN/$LABEL" 2>/dev/null | awk '/^[[:space:]]*pid = /{print $3; exit}'
}

ensure_presets() {
  mkdir -p "$CONFIG_DIR"
  [[ -f "$PRESETS" ]] && return
  cat > "$PRESETS" <<'EOF'
# vdscreen 预设：每行 "名字 = 宽x高"，数值是逻辑尺寸（程序自动按 2x 背板创建）。
# 可自由增删改，菜单栏和命令行会立即读取，无需重新编译。

# iPad（横屏，与桌面习惯一致）
iPad mini 7                  = 1133x744
iPad Air 11 / iPad 10-11     = 1180x820
iPad Air 13 / iPad Pro 12.9  = 1366x1024
iPad Pro 11 (M4)             = 1210x834
iPad Pro 13 (M4)             = 1376x1032

# iPhone（竖屏，正好铺满手机）
# 注意：macOS 只对"足够大"的虚拟屏提供 HiDPI（实测逻辑宽度 ≳900）。
# 手机尺寸拿不到 HiDPI，程序会自动退回 1:1 —— UI 比例正确，画面略软。
# 想要更锐利可换用更宽的等价尺寸（代价是 UI 显得更小），例如：
#   iPhone 18 Pro（锐）      = 603x1311
#   iPhone 18 Pro（很锐）    = 900x1956
iPhone 18 Pro                = 402x874
iPhone 18 Pro Max            = 440x956
iPhone 17 / 18 (6.3")        = 402x874
iPhone Air                   = 420x912
iPhone SE (3rd)              = 375x667

# 通用分辨率
1080p                        = 960x540
1440p                        = 1280x720
4K                           = 1920x1080
EOF
}

preset_size() {
  ensure_presets
  awk -F'=' -v want="$1" '
    /^[[:space:]]*#/ { next }
    NF >= 2 {
      name = $1; sub(/[[:space:]]+$/, "", name); sub(/^[[:space:]]+/, "", name)
      size = $2; gsub(/[[:space:]]/, "", size)
      if (name == want) { print size; exit }
    }' "$PRESETS"
}

# 当前生效的尺寸/名字：以 plist 为准（没在运行时退回配置值）
current_size() {
  local value=""
  [[ -f "$PLIST" ]] && value="$(/usr/libexec/PlistBuddy -c "Print :ProgramArguments:1" "$PLIST" 2>/dev/null)"
  print -r -- "${value:-$SIZE}"
}

current_name() {
  local value=""
  [[ -f "$PLIST" ]] && value="$(/usr/libexec/PlistBuddy -c "Print :ProgramArguments:2" "$PLIST" 2>/dev/null)"
  print -r -- "${value:-$NAME}"
}

# macOS 不接受高度 < 480 的显示器（会被替换成 800x600 之类的默认模式，
# 例如手机横屏的 874x402）。这里保持宽高比、等比放大到高 480。
normalize_size() {
  local size="$1" w h
  w="${size%%x*}"
  h="${size##*x}"
  [[ "$w" =~ ^[0-9]+$ && "$h" =~ ^[0-9]+$ ]] || { print -r -- "$size"; return }
  if (( h < 480 )); then
    local nw=$(( (w * 480 + h / 2) / h ))
    print -ru2 -- "提示: 高 $h 低于系统下限 480，已保持宽高比放大为 ${nw}x480"
    print -r -- "${nw}x480"
  else
    print -r -- "${w}x${h}"
  fi
}

# 如实汇报实际结果：背板尺寸 vs 逻辑尺寸。
# 只有 system_profiler 反映真实背板（CoreGraphics 对虚拟屏的 pixel 查询不可信）。
report_dpi() {
  local name="$1" block res ui
  block="$(system_profiler SPDisplaysDataType 2>/dev/null | grep -A 3 "^        $name:" | head -4)"
  [[ -z "$block" ]] && return
  res="$(print -r -- "$block" | awk '/Resolution:/{n=0; for(i=1;i<=NF;i++) if($i ~ /^[0-9]+$/) {printf "%s", $i; n++; if(n==1) printf "x"; else exit}}')"
  ui="$(print -r -- "$block" | awk '/UI Looks like:/{n=0; for(i=1;i<=NF;i++) if($i ~ /^[0-9]+$/) {printf "%s", $i; n++; if(n==1) printf "x"; else exit}}')"
  [[ -z "$res" || -z "$ui" ]] && return
  if [[ "$res" == "$ui" ]]; then
    print -r -- "  实际: 背板 $res / 逻辑 $ui —— 非 HiDPI，画面会略软"
  else
    print -r -- "  实际: 背板 $res / 逻辑 $ui —— HiDPI"
  fi
}

write_plist() {
  [[ -x "$CORE" ]] || die "找不到可执行文件 $CORE（先跑 ./build.sh，或 vdscreen install）"
  mkdir -p "$(dirname "$PLIST")"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$CORE</string>
    <string>$SIZE</string>
    <string>$NAME</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>StandardOutPath</key><string>/tmp/vdscreen.log</string>
  <key>StandardErrorPath</key><string>/tmp/vdscreen.err</string>
</dict>
</plist>
EOF
}

show_status() {
  local state="未加载"
  loaded && state="已加载"
  say "服务:      $state ($LABEL)"
  say "配置:      $SIZE  \"$NAME\""
  say "核心:      $CORE"
  local pid; pid="$(current_pid)"
  say "进程:      ${pid:-无}"
  local info
  info="$(system_profiler SPDisplaysDataType 2>/dev/null | grep -A 3 "^        $NAME:" | head -4)"
  if [[ -n "$info" ]]; then
    say "显示器:"
    print -r -- "$info" | sed 's/^/           /'
  else
    say "显示器:    未出现"
  fi
}

case "${1:-status}" in
  on)
    [[ -n "${2:-}" ]] && SIZE="$2"
    [[ -n "${3:-}" ]] && NAME="$3"
    SIZE="$(normalize_size "$SIZE")"
    write_plist
    : > /tmp/vdscreen.log
    : > /tmp/vdscreen.err
    # 必须先 bootout 再 bootstrap：kickstart 只会用 launchd 缓存的旧配置重启，
    # 改了尺寸/名字它不会重读 plist，切换分辨率就会"没反应"。
    if loaded; then
      launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
      sleep 0.5
    fi
    launchctl bootstrap "$DOMAIN" "$PLIST"
    sleep 3
    if [[ -z "$(current_pid)" ]]; then
      print -ru2 -- "警告: 服务已加载但进程未起来，显示器可能没创建成功"
    fi
    cat /tmp/vdscreen.log 2>/dev/null || true
    report_dpi "$NAME"
    show_status
    ;;
  off)
    if loaded; then launchctl bootout "$DOMAIN/$LABEL"; fi
    rm -f "$PLIST"
    say "已关闭（是否开机自启：否）"
    ;;
  restart)
    "$0" off >/dev/null 2>&1 || true
    "$0" on "${2:-}" "${3:-}"
    ;;
  status) show_status ;;
  state)
    # 机器可读：供菜单栏等程序解析
    if [[ -n "$(current_pid)" && -f "$PLIST" ]]; then
      say "on $(current_name) $(current_size)"
    else
      say "off"
    fi
    ;;
  rotate)
    # 横竖切换：把当前宽高对调（手机竖屏 ↔ 横屏）
    local size width height
    size="$(current_size)"
    width="${size%%x*}"
    height="${size##*x}"
    [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]] || die "当前尺寸无法解析: $size"
    "$0" on "${height}x${width}" "$(current_name)"
    ;;
  presets)
    ensure_presets
    cat "$PRESETS"
    ;;
  preset)
    [[ -n "${2:-}" ]] || die "用法: vdscreen preset <预设名>（用 vdscreen presets 查看）"
    size="$(preset_size "$2")"
    [[ -n "$size" ]] || die "找不到预设「$2」，可用 vdscreen presets 查看列表"
    "$0" on "$size" "$2"
    ;;
  config)
    mkdir -p "$CONFIG_DIR"
    [[ -f "$CONFIG" ]] || cat > "$CONFIG" <<EOF
CORE="$SELF_DIR/vdscreen-core"
NAME="iPad mini 7"
SIZE="1133x744"
EOF
    say "$CONFIG:"; say ""
    cat "$CONFIG"
    ;;
  set)
    key="${2:-}"; val="${3:-}"
    [[ -n "$key" && -n "$val" ]] || die "用法: vdscreen set <size|name|core> <值>"
    mkdir -p "$CONFIG_DIR"
    [[ -f "$CONFIG" ]] || cat > "$CONFIG" <<EOF
CORE="$CORE"
NAME="$NAME"
SIZE="$SIZE"
EOF
    case "$key" in
      size) SIZE="$val" ;;
      name) NAME="$val" ;;
      core) CORE="$val" ;;
      *) die "只支持 size / name / core" ;;
    esac
    # 重写配置（保持三行结构）
    { echo "CORE=\"$CORE\""; echo "NAME=\"$NAME\""; echo "SIZE=\"$SIZE\""; } > "$CONFIG"
    say "已更新 $key = $val"
    loaded && say "（正在运行，执行 vdscreen restart 生效）"
    ;;
  install)
    [[ -x "$CORE" ]] || { say "先编译核心…"; "$SELF_DIR/build.sh"; }
    mkdir -p "$CONFIG_DIR"
    { echo "CORE=\"$SELF_DIR/vdscreen-core\""; echo "NAME=\"$NAME\""; echo "SIZE=\"$SIZE\""; } > "$CONFIG"
    mkdir -p "$HOME/bin"
    cp "$SELF_DIR/vdscreen" "$HOME/bin/vdscreen"
    chmod +x "$HOME/bin/vdscreen"
    say "已安装: ~/bin/vdscreen"
    case ":$PATH:" in
      *":$HOME/bin:"*) say "现在可以直接用: vdscreen status" ;;
      *) say "注意: ~/bin 不在 PATH 中，请把它加进 PATH" ;;
    esac
    ;;
  uninstall)
    "$0" off >/dev/null 2>&1 || true
    [[ -f "$HOME/bin/vdscreen" ]] && rm "$HOME/bin/vdscreen"
    say "已卸载命令（保留 $CONFIG 与仓库目录）"
    ;;
  help|-h|--help)
    awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
    ;;
  *) die "未知命令: $1（试试 vdscreen help）" ;;
esac
