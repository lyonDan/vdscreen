#!/bin/zsh
# vdscreen — macOS 虚拟显示器管理
#
#   vdscreen on [宽x高] [名字]   启动虚拟屏（可临时覆盖尺寸/名字）
#   vdscreen off                 关闭
#   vdscreen restart             重启
#   vdscreen status              查看状态（不带参数时的默认动作）
#   vdscreen presets             列出预设分辨率
#   vdscreen preset <名字>       按预设启动（如: vdscreen preset "iPad mini 7"）
#   vdscreen rotate              横竖切换（交换当前宽高，缩放保持）
#   vdscreen zoom                查看当前界面缩放与清晰上限
#   vdscreen zoom 125            界面缩放到 125%（也可写 1.25 / 125%）
#   vdscreen zoom in|out|max|reset  放大 / 缩小 / 放到最大清晰档 / 还原 100%
#   vdscreen state               机器可读状态: "on <名字> <宽x高>" 或 "off"
#   vdscreen config              查看配置文件
#   vdscreen set size 1133x744   改默认尺寸
#   vdscreen set name "iPad mini 7"
#   vdscreen install             装到 ~/bin，之后任意目录可用
#   vdscreen uninstall           停止并移除 ~/bin 里的命令
#
# 显示器与创建它的进程同生命周期，由 LaunchAgent 托管。
# 只要 plist 存在，登录后会自动拉起；off 会移除 plist，确保关闭后不再自动启动。

set -euo pipefail
zmodload zsh/mathfunc

CONFIG_DIR="$HOME/.config/vdscreen"
CONFIG="$CONFIG_DIR/config"
PRESETS="$CONFIG_DIR/presets"
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"

# 默认值；~/.config/vdscreen/config 里的同名变量会覆盖它们。
# 改 LABEL 可以并存多块虚拟屏（一个 LABEL = 一个 LaunchAgent = 一块屏）。
LABEL=""
CORE="$SELF_DIR/vdscreen-core"
NAME="iPad mini 7"
SIZE="1133x744"
ZOOM=1

[[ -f "$CONFIG" ]] && source "$CONFIG"

# 配置里显式写了 LABEL 才算"自定义"；没写则用默认标签
LABEL_FROM_CONFIG=""
[[ -n "$LABEL" ]] && LABEL_FROM_CONFIG=1
if [[ -z "$LABEL" ]]; then
  LABEL="io.github.lyondan.vdscreen"
  # 兼容 1.1.0 及更早的版本：它们的 LaunchAgent 叫这个名字。若它还在而新标签没有，
  # 就继续沿用，直到下一次 `vdscreen off`（off 会删掉旧 plist，之后自然改用新标签）
  LEGACY_LABEL="com.local.vdscreen.ipadmini7"
  if [[ ! -f "$HOME/Library/LaunchAgents/$LABEL.plist" && -f "$HOME/Library/LaunchAgents/$LEGACY_LABEL.plist" ]]; then
    LABEL="$LEGACY_LABEL"
  fi
fi

# 必须在读取配置之后计算，否则配置里改 LABEL 会失效
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"

say()  { print -r -- "$@" }
die()  { print -ru2 -- "错误: $@"; exit 1; }
loaded() { launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; }

current_pid() {
  launchctl print "$DOMAIN/$LABEL" 2>/dev/null | awk '/^[[:space:]]*pid = /{print $3; exit}'
}

ensure_presets() {
  mkdir -p "$CONFIG_DIR"
  [[ -f "$PRESETS" ]] && return
  cat > "$PRESETS" <<'EOF'
# vdscreen 预设：每行 "名字 = 宽x高"，数值是逻辑尺寸（程序自动按 2x 背板创建）。
# 可自由增删改，菜单栏和命令行会立即读取，无需重新编译。

# iPad（横屏，与桌面习惯一致）
iPad mini 7                  = 1133x744
iPad Air 11 / iPad 10-11     = 1180x820
iPad Air 13 / iPad Pro 12.9  = 1366x1024
iPad Pro 11 (M4)             = 1210x834
iPad Pro 13 (M4)             = 1376x1032

# iPhone（竖屏）
# 这里用手机的"像素尺寸"而不是"点尺寸"：402x874 点宽放不下普通 Mac 窗口，
# 而且太小的虚拟屏 macOS 不给 HiDPI（会退回 1:1，又小又糊）。
# 用像素尺寸当画布既够宽、又能拿到 HiDPI，切横屏用 rotate（1748x804 同样是 HiDPI）。
# 嫌字太小可以让客户端缩放；想换更小的画布就自己改，程序会自动退回 1:1。
iPhone 18 Pro                = 804x1748
iPhone 18 Pro Max            = 880x1912
iPhone 17 / 18 (6.3")        = 804x1748
iPhone Air                   = 840x1824
iPhone SE (3rd)              = 750x1334

# 通用分辨率
1080p                        = 960x540
1440p                        = 1280x720
4K                           = 1920x1080
EOF
}

preset_size() {
  ensure_presets
  awk -F'=' -v want="$1" '
    /^[[:space:]]*#/ { next }
    NF >= 2 {
      name = $1; sub(/[[:space:]]+$/, "", name); sub(/^[[:space:]]+/, "", name)
      size = $2; gsub(/[[:space:]]/, "", size)
      if (name == want) { print size; exit }
    }' "$PRESETS"
}

# 当前生效的尺寸/名字：以 plist 为准（没在运行时退回配置值）
current_size() {
  local value=""
  [[ -f "$PLIST" ]] && value="$(/usr/libexec/PlistBuddy -c "Print :ProgramArguments:1" "$PLIST" 2>/dev/null)"
  print -r -- "${value:-$SIZE}"
}

# 用户原本请求的尺寸（normalize_size 放大之前）。rotate 以它为准，
# 这样 402x874 → 874x402 → 402x874 能原路返回，而不是停在放大后的档位。
current_requested() {
  local value=""
  [[ -f "$PLIST" ]] && value="$(/usr/libexec/PlistBuddy -c "Print :RequestedSize" "$PLIST" 2>/dev/null)"
  print -r -- "${value:-$(current_size)}"
}

current_zoom() {
  local value=""
  [[ -f "$PLIST" ]] && value="$(/usr/libexec/PlistBuddy -c "Print :Zoom" "$PLIST" 2>/dev/null)"
  print -r -- "${value:-1}"
}

current_name() {
  local value=""
  [[ -f "$PLIST" ]] && value="$(/usr/libexec/PlistBuddy -c "Print :ProgramArguments:2" "$PLIST" 2>/dev/null)"
  print -r -- "${value:-$NAME}"
}

# ── 界面缩放 ────────────────────────────────────────────────────────────
# 缩放 = 把"请求尺寸"除以倍数得到逻辑画布：125% → 画布缩小到 1/1.25，UI 看起来大 1.25 倍。
# 缩小画布有代价：macOS 只给足够大的虚拟屏 HiDPI（实测 660x800/800x600 有，
# 650x1000/660x700/760x600/1000x480 没有），过小就退回 1:1（比例对、画面软）。
# 下面的预测公式取了一点余量；最终是否清晰以核心的实测汇报为准。
ZOOM_MIN=0.5
ZOOM_MAX=2.0
ZOOM_LEVELS=(0.5 0.67 0.75 0.9 1 1.1 1.25 1.5 1.75 2)

# 请求尺寸下，还能保持 HiDPI 的最大缩放倍数（两位小数，向下取整）
sharp_zoom_max() {
  local w="${1%%x*}" h="${1##*x}"
  [[ "$w" =~ ^[0-9]+$ && "$h" =~ ^[0-9]+$ ]] || { print -r -- "1.00"; return }
  local a=$(( w / 670.0 ))
  local b=$(( h / 600.0 ))
  local c=$(( sqrt(w * h / 480000.0) ))
  local m=$a
  if (( b < m )); then m=$b; fi
  if (( c < m )); then m=$c; fi
  printf '%.2f' $(( floor(m * 100) / 100 ))
}

# 请求尺寸 + 倍数 → 逻辑画布尺寸（倍数为 1 时原样返回，保留奇数尺寸）
apply_zoom() {
  local w="${1%%x*}" h="${1##*x}" z="$2"
  if (( z == 1 )); then print -r -- "${w}x${h}"; return; fi
  print -r -- "$(( int(rint(w / (z + 0.0))) ))x$(( int(rint(h / (z + 0.0))) ))"
}

# "125" / "125%" / "1.25" → 1.25；非法返回 1
parse_zoom() {
  local raw="$1" v="${1%\%}"
  [[ "$v" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 1
  if [[ "$raw" == *% ]] || (( v > 10 )); then v=$(( v / 100.0 )); fi
  print -r -- "$v"
}

# in/out 的下一档：沿预设档位走，但会先停在清晰上限，让人知道再往后就开始变软
next_zoom() {
  local dir="$1" cur="$2" smax="$3" lv best
  if [[ "$dir" == in ]]; then
    best=$ZOOM_MAX
    for lv in $ZOOM_LEVELS; do
      if (( lv > cur + 0.005 && lv < best )); then best=$lv; fi
    done
    if (( cur + 0.005 < smax && smax < best )); then best=$smax; fi
  else
    best=$ZOOM_MIN
    for lv in $ZOOM_LEVELS; do
      if (( lv < cur - 0.005 && lv > best )); then best=$lv; fi
    done
    if (( cur - 0.005 > smax && smax > best )); then best=$smax; fi
  fi
  print -r -- "$best"
}

# macOS 不接受高度 < 480 的显示器（会被替换成 800x600 之类的默认模式，
# 例如手机横屏的 874x402）。这里保持宽高比、等比放大到高 480。
normalize_size() {
  local size="$1" w h
  w="${size%%x*}"
  h="${size##*x}"
  [[ "$w" =~ ^[0-9]+$ && "$h" =~ ^[0-9]+$ ]] || { print -r -- "$size"; return }
  if (( h < 480 )); then
    local nw=$(( (w * 480 + h / 2) / h ))
    print -ru2 -- "提示: 高 $h 低于系统下限 480，已保持宽高比放大为 ${nw}x480"
    print -r -- "${nw}x480"
  else
    print -r -- "${w}x${h}"
  fi
}

# 如实汇报实际结果：背板尺寸 vs 逻辑尺寸。
# 只有 system_profiler 反映真实背板（CoreGraphics 对虚拟屏的 pixel 查询不可信）。
report_dpi() {
  local name="$1" block res ui
  # -F 按字面匹配：名字里可能有正则元字符（如 . *）
  block="$(system_profiler SPDisplaysDataType 2>/dev/null | grep -F -A 3 "        $name:" | head -4)"
  [[ -z "$block" ]] && return
  res="$(print -r -- "$block" | awk '/Resolution:/{n=0; for(i=1;i<=NF;i++) if($i ~ /^[0-9]+$/) {printf "%s", $i; n++; if(n==1) printf "x"; else exit}}')"
  ui="$(print -r -- "$block" | awk '/UI Looks like:/{n=0; for(i=1;i<=NF;i++) if($i ~ /^[0-9]+$/) {printf "%s", $i; n++; if(n==1) printf "x"; else exit}}')"
  [[ -z "$res" || -z "$ui" ]] && return
  if [[ "$res" == "$ui" ]]; then
    print -r -- "  实际: 背板 $res / 逻辑 $ui —— 非 HiDPI，画面会略软"
  else
    print -r -- "  实际: 背板 $res / 逻辑 $ui —— HiDPI"
  fi
}

# 等核心就绪（日志里出现"已就绪"），而不是盲睡：核心创建 + 校验 + 必要时显式切 HiDPI
# 最坏要 5 秒多。进程提前退出（创建失败）或超时则返回 1。
wait_ready() {
  local i
  for i in {1..80}; do
    grep -q '已就绪' /tmp/vdscreen.log 2>/dev/null && return 0
    (( i > 4 )) && [[ -z "$(current_pid)" ]] && return 1
    sleep 0.25
  done
  return 1
}

# plist 是 XML：名字里有 & < > 时必须转义，否则 launchd 读不了
xml_escape() {
  local v="$1"
  v="${v//&/&amp;}"; v="${v//</&lt;}"; v="${v//>/&gt;}"
  print -r -- "$v"
}

write_plist() {
  [[ -x "$CORE" ]] || die "找不到可执行文件 $CORE（先跑 ./build.sh，或 vdscreen install）"
  mkdir -p "$(dirname "$PLIST")"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$(xml_escape "$LABEL")</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(xml_escape "$CORE")</string>
    <string>$SIZE</string>
    <string>$(xml_escape "$NAME")</string>
  </array>
  <key>RequestedSize</key><string>${REQUESTED:-$SIZE}</string>
  <key>Zoom</key><string>${ZOOM:-1}</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>StandardOutPath</key><string>/tmp/vdscreen.log</string>
  <key>StandardErrorPath</key><string>/tmp/vdscreen.err</string>
</dict>
</plist>
EOF
}

show_status() {
  local state="未加载"
  loaded && state="已加载"
  say "服务:      $state ($LABEL)"
  if [[ -f "$PLIST" ]]; then
    NAME="$(current_name)"
    SIZE="$(current_size)"
    say "当前:      $SIZE  \"$NAME\""
  else
    say "配置:      $SIZE  \"$NAME\"（默认值，未开启）"
  fi
  say "核心:      $CORE"
  local pid; pid="$(current_pid)"
  say "进程:      ${pid:-无}"
  local info
  info="$(system_profiler SPDisplaysDataType 2>/dev/null | grep -F -A 3 "        $NAME:" | head -4)"
  if [[ -n "$info" ]]; then
    say "显示器:"
    print -r -- "$info" | sed 's/^/           /'
  else
    say "显示器:    未出现"
  fi
}

# 测试用：VDS_LIB=1 source ./vdscreen 只加载函数，不执行任何命令
[[ -n "${VDS_LIB:-}" ]] && return 0

case "${1:-status}" in
  on)
    [[ -n "${2:-}" ]] && SIZE="$2"
    [[ -n "${3:-}" ]] && NAME="$3"
    REQUESTED="$SIZE"
    ZOOM="${VDS_ZOOM:-1}"          # 只有 zoom / rotate 会带上；换预设、手动 on 都还原为 100%
    SIZE="$(normalize_size "$(apply_zoom "$SIZE" "$ZOOM")")"
    write_plist
    : > /tmp/vdscreen.log
    : > /tmp/vdscreen.err
    # 必须先 bootout 再 bootstrap：kickstart 只会用 launchd 缓存的旧配置重启，
    # 改了尺寸/名字它不会重读 plist，切换分辨率就会"没反应"。
    if loaded; then
      launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
      sleep 0.5
    fi
    launchctl bootstrap "$DOMAIN" "$PLIST"
    if ! wait_ready; then
      print -ru2 -- "警告: 核心没有在预期时间内就绪，显示器可能没创建成功"
      cat /tmp/vdscreen.err 2>/dev/null >&2 || true
    fi
    cat /tmp/vdscreen.log 2>/dev/null || true
    sleep 0.5    # 给 system_profiler 一点时间看到新显示器
    report_dpi "$NAME"
    if (( ZOOM != 1 )); then
      say "  缩放: $(( int(rint(ZOOM * 100)) ))%（请求 $REQUESTED → 画布 $SIZE）"
    fi
    show_status
    ;;
  off)
    if loaded; then launchctl bootout "$DOMAIN/$LABEL"; fi
    rm -f "$PLIST"
    say "已关闭（是否开机自启：否）"
    ;;
  restart)
    "$0" off >/dev/null 2>&1 || true
    "$0" on "${2:-}" "${3:-}"
    ;;
  status) show_status ;;
  state)
    # 机器可读：供菜单栏等程序解析
    if [[ -n "$(current_pid)" && -f "$PLIST" ]]; then
      say "on $(current_name) $(current_size)"
    else
      say "off"
    fi
    ;;
  rotate)
    # 横竖切换：把"请求的尺寸"宽高对调（手机竖屏 ↔ 横屏）
    [[ -n "$(current_pid)" && -f "$PLIST" ]] || die "虚拟屏未开启，先 vdscreen on"
    size="$(current_requested)"
    width="${size%%x*}"
    height="${size##*x}"
    [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]] || die "当前尺寸无法解析: $size"
    VDS_ZOOM="$(current_zoom)" "$0" on "${height}x${width}" "$(current_name)"
    ;;
  zoominfo)
    # 机器可读: "<当前倍数> <清晰上限>"，菜单栏用它标注哪些档位会变软
    say "$(current_zoom) $(sharp_zoom_max "$(current_requested)")"
    ;;
  zoom)
    [[ -n "$(current_pid)" && -f "$PLIST" ]] || die "虚拟屏未开启，先 vdscreen on"
    req="$(current_requested)"
    cur="$(current_zoom)"
    smax="$(sharp_zoom_max "$req")"
    arg="${2:-}"
    if [[ -z "$arg" ]]; then
      say "当前缩放 $(( int(rint(cur * 100)) ))%（请求 $req → 画布 $(current_size)）"
      say "清晰上限 $(( int(rint(smax * 100)) ))%，超过后 macOS 不再给 HiDPI，画面会略软"
      exit 0
    fi
    case "$arg" in
      in|out) target="$(next_zoom "$arg" "$cur" "$smax")" ;;
      max)    target="$smax" ;;
      reset)  target=1 ;;
      *)      target="$(parse_zoom "$arg")" || die "用法: vdscreen zoom <125|1.25|125%|in|out|max|reset>" ;;
    esac
    if (( target < ZOOM_MIN )); then target=$ZOOM_MIN; fi
    if (( target > ZOOM_MAX )); then target=$ZOOM_MAX; fi
    target="$(printf '%.2f' $target)"
    if (( target == cur )); then
      say "缩放已是 $(( int(rint(cur * 100)) ))%，无需改动"
      exit 0
    fi
    VDS_ZOOM="$target" "$0" on "$req" "$(current_name)"
    ;;
  presets)
    ensure_presets
    cat "$PRESETS"
    ;;
  preset)
    [[ -n "${2:-}" ]] || die "用法: vdscreen preset <预设名>（用 vdscreen presets 查看）"
    size="$(preset_size "$2")"
    [[ -n "$size" ]] || die "找不到预设「$2」，可用 vdscreen presets 查看列表"
    "$0" on "$size" "$2"
    ;;
  config)
    mkdir -p "$CONFIG_DIR"
    [[ -f "$CONFIG" ]] || cat > "$CONFIG" <<EOF
CORE="$SELF_DIR/vdscreen-core"
NAME="iPad mini 7"
SIZE="1133x744"
EOF
    say "$CONFIG:"; say ""
    cat "$CONFIG"
    ;;
  set)
    key="${2:-}"; val="${3:-}"
    [[ -n "$key" && -n "$val" ]] || die "用法: vdscreen set <size|name|core> <值>"
    mkdir -p "$CONFIG_DIR"
    [[ -f "$CONFIG" ]] || cat > "$CONFIG" <<EOF
CORE="$CORE"
NAME="$NAME"
SIZE="$SIZE"
EOF
    case "$key" in
      size) SIZE="$val" ;;
      name) NAME="$val" ;;
      core) CORE="$val" ;;
      *) die "只支持 size / name / core" ;;
    esac
    # 重写配置（保留 LABEL，否则自定义标签会被悄悄丢掉）
    { [[ -n "$LABEL_FROM_CONFIG" ]] && echo "LABEL=\"$LABEL\""; echo "CORE=\"$CORE\""; echo "NAME=\"$NAME\""; echo "SIZE=\"$SIZE\""; } > "$CONFIG"
    say "已更新 $key = $val"
    loaded && say "（正在运行，执行 vdscreen restart 生效）"
    ;;
  install)
    [[ -x "$CORE" ]] || { say "先编译核心…"; "$SELF_DIR/build.sh"; }
    mkdir -p "$CONFIG_DIR"
    { [[ -n "$LABEL_FROM_CONFIG" ]] && echo "LABEL=\"$LABEL\""; echo "CORE=\"$SELF_DIR/vdscreen-core\""; echo "NAME=\"$NAME\""; echo "SIZE=\"$SIZE\""; } > "$CONFIG"
    mkdir -p "$HOME/bin"
    cp "$SELF_DIR/vdscreen" "$HOME/bin/vdscreen"
    chmod +x "$HOME/bin/vdscreen"
    say "已安装: ~/bin/vdscreen"
    case ":$PATH:" in
      *":$HOME/bin:"*) say "现在可以直接用: vdscreen status" ;;
      *) say "注意: ~/bin 不在 PATH 中，请把它加进 PATH" ;;
    esac
    ;;
  uninstall)
    "$0" off >/dev/null 2>&1 || true
    rm -f "$HOME/bin/vdscreen" "$HOME/bin/vdscreen-core"
    say "已卸载命令（保留 $CONFIG 与仓库目录）"
    ;;
  help|-h|--help)
    awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
    ;;
  *) die "未知命令: $1（试试 vdscreen help）" ;;
esac
