#!/bin/zsh
# vdscreen — macOS 虚拟显示器管理
#
#   vdscreen on [宽x高] [名字]   启动虚拟屏（可临时覆盖尺寸/名字）
#   vdscreen off                 关闭
#   vdscreen restart             重启
#   vdscreen status              查看状态（不带参数时的默认动作）
#   vdscreen presets             列出预设分辨率
#   vdscreen preset <名字>       按预设启动（如: vdscreen preset "iPad mini 7"）
#   vdscreen orientation         查看横竖设置（跟随预设 / 锁定横屏 / 锁定竖屏）
#   vdscreen orientation 横屏    锁定横屏（换预设/分辨率后保持；竖屏同理）
#   vdscreen orientation auto    取消锁定，方向跟随预设
#   vdscreen main                 一键切换主屏（虚拟屏 ↔ 第一个其他显示器）
#   vdscreen state               机器可读状态: "on <名字> <宽x高>" 或 "off"
#   vdscreen config              查看配置文件
#   vdscreen set size 1133x744   改默认尺寸
#   vdscreen set name "iPad mini 7"
#   vdscreen install             装到 ~/bin，之后任意目录可用
#   vdscreen uninstall           停止并移除 ~/bin 里的命令
#
# 显示器与创建它的进程同生命周期，由 LaunchAgent 托管。
# 只要 plist 存在，登录后会自动拉起；off 会移除 plist，确保关闭后不再自动启动。

set -euo pipefail

CONFIG_DIR="$HOME/.config/vdscreen"
CONFIG="$CONFIG_DIR/config"
PRESETS="$CONFIG_DIR/presets"
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"

# 默认值；~/.config/vdscreen/config 里的同名变量会覆盖它们。
# 改 LABEL 可以并存多块虚拟屏（一个 LABEL = 一个 LaunchAgent = 一块屏）。
LABEL=""
CORE="$SELF_DIR/vdscreen-core"
NAME="iPad mini 7"
SIZE="1133x744"
ORIENTATION="auto"   # auto=跟随预设 | landscape=锁定横屏 | portrait=锁定竖屏

[[ -f "$CONFIG" ]] && source "$CONFIG"

# 配置里显式写了 LABEL 才算"自定义"；没写则用默认标签
LABEL_FROM_CONFIG=""
[[ -n "$LABEL" ]] && LABEL_FROM_CONFIG=1
if [[ -z "$LABEL" ]]; then
  LABEL="io.github.lyondan.vdscreen"
  # 兼容 1.1.0 及更早的版本：它们的 LaunchAgent 叫这个名字。若它还在而新标签没有，
  # 就继续沿用，直到下一次 `vdscreen off`（off 会删掉旧 plist，之后自然改用新标签）
  LEGACY_LABEL="com.local.vdscreen.ipadmini7"
  if [[ ! -f "$HOME/Library/LaunchAgents/$LABEL.plist" && -f "$HOME/Library/LaunchAgents/$LEGACY_LABEL.plist" ]]; then
    LABEL="$LEGACY_LABEL"
  fi
fi

# 必须在读取配置之后计算，否则配置里改 LABEL 会失效
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"

say()  { print -r -- "$@" }
die()  { print -ru2 -- "错误: $@"; exit 1; }
loaded() { launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; }

current_pid() {
  launchctl print "$DOMAIN/$LABEL" 2>/dev/null | awk '/^[[:space:]]*pid = /{print $3; exit}'
}

ensure_presets() {
  mkdir -p "$CONFIG_DIR"
  [[ -f "$PRESETS" ]] && return
  cat > "$PRESETS" <<'EOF'
# vdscreen 预设：每行 "名字 = 宽x高"，数值是逻辑尺寸（程序自动按 2x 背板创建）。
# 可自由增删改，菜单栏和命令行会立即读取，无需重新编译。

# iPad（横屏，与桌面习惯一致）
iPad mini 7                  = 1133x744
iPad Air 11 / iPad 10-11     = 1180x820
iPad Air 13 / iPad Pro 12.9  = 1366x1024
iPad Pro 11 (M4)             = 1210x834
iPad Pro 13 (M4)             = 1376x1032

# iPhone（竖屏）
# 这里用手机的"像素尺寸"而不是"点尺寸"：402x874 点宽放不下普通 Mac 窗口，
# 而且太小的虚拟屏 macOS 不给 HiDPI（会退回 1:1，又小又糊）。
# 用像素尺寸当画布既够宽、又能拿到 HiDPI，横竖方向用 vdscreen orientation 切换。
# 嫌字太小可以让客户端缩放；想换更小的画布就自己改，程序会自动退回 1:1。
iPhone 18 Pro                = 804x1748
iPhone 18 Pro Max            = 880x1912
iPhone 17 / 18 (6.3")        = 804x1748

# 通用显示器分辨率（逻辑尺寸，程序自动按 2x 背板创建；
# 想要其他分辨率直接照格式加一行，或用 vdscreen on <宽x高> 临时指定）
1600x900                     = 1600x900
1280x720                     = 1280x720
1920x1080                    = 1920x1080
EOF
}

preset_size() {
  ensure_presets
  awk -F'=' -v want="$1" '
    /^[[:space:]]*#/ { next }
    NF >= 2 {
      name = $1; sub(/[[:space:]]+$/, "", name); sub(/^[[:space:]]+/, "", name)
      size = $2; gsub(/[[:space:]]/, "", size)
      if (name == want) { print size; exit }
    }' "$PRESETS"
}

# 当前生效的尺寸/名字：以 plist 为准（没在运行时退回配置值）
current_size() {
  local value=""
  [[ -f "$PLIST" ]] && value="$(/usr/libexec/PlistBuddy -c "Print :ProgramArguments:1" "$PLIST" 2>/dev/null)"
  print -r -- "${value:-$SIZE}"
}

# 应用方向锁定：auto 原样返回；landscape/portrait 把宽高摆成对应方向（方形尺寸不动）
apply_orientation() {
  local size="$1" w h
  if [[ "$ORIENTATION" != "landscape" && "$ORIENTATION" != "portrait" ]]; then
    print -r -- "$size"; return
  fi
  w="${size%%x*}"; h="${size##*x}"
  if [[ "$w" =~ ^[0-9]+$ && "$h" =~ ^[0-9]+$ ]] && (( w != h )); then
    # 注意用算术比较：[[ h > w ]] 是字典序（804 > 1748），方向判断会错
    if [[ "$ORIENTATION" == "landscape" ]] && (( h > w )); then print -r -- "${h}x${w}"
    elif [[ "$ORIENTATION" == "portrait" ]] && (( w > h )); then print -r -- "${h}x${w}"
    else print -r -- "$size"; fi
  else
    print -r -- "$size"
  fi
}

# 用户原本请求的尺寸（normalize_size 放大之前）。orientation 锁定以它为准重摆，
# 这样 402x874 被放大后仍能原路切回用户请求的方向。
current_requested() {
  local value=""
  [[ -f "$PLIST" ]] && value="$(/usr/libexec/PlistBuddy -c "Print :RequestedSize" "$PLIST" 2>/dev/null)"
  print -r -- "${value:-$(current_size)}"
}

current_name() {
  local value=""
  [[ -f "$PLIST" ]] && value="$(/usr/libexec/PlistBuddy -c "Print :ProgramArguments:2" "$PLIST" 2>/dev/null)"
  print -r -- "${value:-$NAME}"
}

# macOS 不接受高度 < 480 的显示器（会被替换成 800x600 之类的默认模式，
# 例如手机横屏的 874x402）。这里保持宽高比、等比放大到高 480。
normalize_size() {
  local size="$1" w h
  w="${size%%x*}"
  h="${size##*x}"
  [[ "$w" =~ ^[0-9]+$ && "$h" =~ ^[0-9]+$ ]] || { print -r -- "$size"; return }
  if (( h < 480 )); then
    local nw=$(( (w * 480 + h / 2) / h ))
    print -ru2 -- "提示: 高 $h 低于系统下限 480，已保持宽高比放大为 ${nw}x480"
    print -r -- "${nw}x480"
  else
    print -r -- "${w}x${h}"
  fi
}

# 如实汇报实际结果：背板尺寸 vs 逻辑尺寸。
# 只有 system_profiler 反映真实背板（CoreGraphics 对虚拟屏的 pixel 查询不可信）。
report_dpi() {
  local name="$1" block res ui
  # -F 按字面匹配：名字里可能有正则元字符（如 . *）
  block="$(system_profiler SPDisplaysDataType 2>/dev/null | grep -F -A 3 "        $name:" | head -4)"
  [[ -z "$block" ]] && return
  res="$(print -r -- "$block" | awk '/Resolution:/{n=0; for(i=1;i<=NF;i++) if($i ~ /^[0-9]+$/) {printf "%s", $i; n++; if(n==1) printf "x"; else exit}}')"
  ui="$(print -r -- "$block" | awk '/UI Looks like:/{n=0; for(i=1;i<=NF;i++) if($i ~ /^[0-9]+$/) {printf "%s", $i; n++; if(n==1) printf "x"; else exit}}')"
  [[ -z "$res" || -z "$ui" ]] && return
  if [[ "$res" == "$ui" ]]; then
    print -r -- "  实际: 背板 $res / 逻辑 $ui —— 非 HiDPI，画面会略软"
  else
    print -r -- "  实际: 背板 $res / 逻辑 $ui —— HiDPI"
  fi
}

# 等核心就绪（日志里出现"已就绪"），而不是盲睡：核心创建 + 校验 + 必要时显式切 HiDPI
# 最坏要 5 秒多。进程提前退出（创建失败）或超时则返回 1。
wait_ready() {
  local i
  for i in {1..80}; do
    grep -q '已就绪' /tmp/vdscreen.log 2>/dev/null && return 0
    (( i > 4 )) && [[ -z "$(current_pid)" ]] && return 1
    sleep 0.25
  done
  return 1
}

# plist 是 XML：名字里有 & < > 时必须转义，否则 launchd 读不了
xml_escape() {
  local v="$1"
  v="${v//&/&amp;}"; v="${v//</&lt;}"; v="${v//>/&gt;}"
  print -r -- "$v"
}

write_plist() {
  [[ -x "$CORE" ]] || die "找不到可执行文件 $CORE（先跑 ./build.sh，或 vdscreen install）"
  mkdir -p "$(dirname "$PLIST")"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$(xml_escape "$LABEL")</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(xml_escape "$CORE")</string>
    <string>$SIZE</string>
    <string>$(xml_escape "$NAME")</string>
  </array>
  <key>RequestedSize</key><string>${REQUESTED:-$SIZE}</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>StandardOutPath</key><string>/tmp/vdscreen.log</string>
  <key>StandardErrorPath</key><string>/tmp/vdscreen.err</string>
</dict>
</plist>
EOF
}

show_status() {
  local state="未加载"
  loaded && state="已加载"
  say "服务:      $state ($LABEL)"
  if [[ -f "$PLIST" ]]; then
    NAME="$(current_name)"
    SIZE="$(current_size)"
    say "当前:      $SIZE  \"$NAME\""
  else
    say "配置:      $SIZE  \"$NAME\"（默认值，未开启）"
  fi
  say "核心:      $CORE"
  local pid; pid="$(current_pid)"
  say "进程:      ${pid:-无}"
  local info
  info="$(system_profiler SPDisplaysDataType 2>/dev/null | grep -F -A 3 "        $NAME:" | head -4)"
  if [[ -n "$info" ]]; then
    say "显示器:"
    print -r -- "$info" | sed 's/^/           /'
  else
    say "显示器:    未出现"
  fi
}

# 测试用：VDS_LIB=1 source ./vdscreen 只加载函数，不执行任何命令
[[ -n "${VDS_LIB:-}" ]] && return 0

case "${1:-status}" in
  on)
    [[ -n "${2:-}" ]] && SIZE="$2"
    [[ -n "${3:-}" ]] && NAME="$3"
    # 方向锁定：换预设/分辨率也保持所选方向（auto = 跟随预设原样）
    SIZE="$(apply_orientation "$SIZE")"
    REQUESTED="$SIZE"
    SIZE="$(normalize_size "$SIZE")"
    write_plist
    : > /tmp/vdscreen.log
    : > /tmp/vdscreen.err
    # 必须先 bootout 再 bootstrap：kickstart 只会用 launchd 缓存的旧配置重启，
    # 改了尺寸/名字它不会重读 plist，切换分辨率就会"没反应"。
    if loaded; then
      launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
      sleep 0.5
    fi
    launchctl bootstrap "$DOMAIN" "$PLIST"
    if ! wait_ready; then
      print -ru2 -- "警告: 核心没有在预期时间内就绪，显示器可能没创建成功"
      cat /tmp/vdscreen.err 2>/dev/null >&2 || true
    fi
    cat /tmp/vdscreen.log 2>/dev/null || true
    sleep 0.5    # 给 system_profiler 一点时间看到新显示器
    report_dpi "$NAME"
    show_status
    ;;
  off)
    if loaded; then launchctl bootout "$DOMAIN/$LABEL"; fi
    rm -f "$PLIST"
    say "已关闭（是否开机自启：否）"
    ;;
  restart)
    "$0" off >/dev/null 2>&1 || true
    "$0" on "${2:-}" "${3:-}"
    ;;
  status) show_status ;;
  orientation)
    # 方向锁定：横屏 / 竖屏 勾选项（持久，换预设/分辨率后保持）；auto 取消锁定
    arg="${2:-}"
    if [[ -z "$arg" ]]; then
      case "$ORIENTATION" in
        landscape) say "orientation=landscape（锁定横屏，换预设/分辨率后保持）" ;;
        portrait)  say "orientation=portrait（锁定竖屏，换预设/分辨率后保持）" ;;
        *)         say "orientation=auto（跟随预设；可设: 横屏|竖屏|auto）" ;;
      esac
      exit 0
    fi
    case "$arg" in
      横屏|landscape|horizontal) ORIENTATION="landscape" ;;
      竖屏|portrait|vertical)    ORIENTATION="portrait" ;;
      auto|跟随|取消)            ORIENTATION="auto" ;;
      *) die "用法: vdscreen orientation [横屏|竖屏|auto]" ;;
    esac
    mkdir -p "$CONFIG_DIR"
    [[ -f "$CONFIG" ]] || { echo "CORE=\"$SELF_DIR/vdscreen-core\""; echo "NAME=\"$NAME\""; echo "SIZE=\"$SIZE\""; } > "$CONFIG"
    # 重写配置，保留所有已有键（LABEL/CORE/NAME/SIZE），追加/替换 ORIENTATION
    { grep -v '^ORIENTATION=' "$CONFIG" 2>/dev/null; echo "ORIENTATION=\"$ORIENTATION\""; } > "$CONFIG.new" && mv "$CONFIG.new" "$CONFIG"
    case "$ORIENTATION" in
      landscape) say "已锁定横屏（换预设/分辨率后保持）" ;;
      portrait)  say "已锁定竖屏（换预设/分辨率后保持）" ;;
      auto)      say "已取消锁定，方向跟随预设" ;;
    esac
    if [[ -n "$(current_pid)" && -f "$PLIST" ]]; then
      # 方向没变就别重建屏幕（重建一次 5–10 秒）；变了才立即重摆（保持名字）
      new_size="$(apply_orientation "$(current_requested)")"
      if [[ "$new_size" != "$(current_requested)" ]]; then
        # 透传重摆后的核对结果（背板 vs 逻辑），菜单栏与集成测试都靠它判断 HiDPI
        "$0" on "$new_size" "$(current_name)" 2>&1 | grep '^  实际' || true
        say "当前虚拟屏已按所选方向应用"
      fi
    fi
    ;;
  state)
    # 机器可读：供菜单栏等程序解析
    if [[ -n "$(current_pid)" && -f "$PLIST" ]]; then
      say "on $(current_name) $(current_size)"
    else
      say "off"
    fi
    ;;
  presets)
    ensure_presets
    cat "$PRESETS"
    ;;
  main)
    # 一键主屏：虚拟屏 ↔ 第一个其他在线显示器。主屏 = 菜单栏/Dock 所在的屏，
    # 分辨率不变；再执行一次即切回。远程时想看到/操作已打开的窗口，把虚拟屏设为主屏即可。
    [[ -n "$(current_pid)" && -f "$PLIST" ]] || die "虚拟屏未开启，先 vdscreen on"
    [[ -x "$CORE" ]] || die "找不到可执行文件 $CORE（先跑 ./build.sh，或 vdscreen install）"
    vid="$(grep -o 'displayID=[0-9]*' /tmp/vdscreen.log 2>/dev/null | tail -1 | cut -d= -f2 || true)"
    [[ -n "$vid" ]] || die "日志里找不到 displayID，查看 /tmp/vdscreen.log"
    "$CORE" main "$vid"
    ;;
  preset)
    [[ -n "${2:-}" ]] || die "用法: vdscreen preset <预设名>（用 vdscreen presets 查看）"
    size="$(preset_size "$2")"
    [[ -n "$size" ]] || die "找不到预设「$2」，可用 vdscreen presets 查看列表"
    "$0" on "$size" "$2"
    ;;
  config)
    mkdir -p "$CONFIG_DIR"
    [[ -f "$CONFIG" ]] || cat > "$CONFIG" <<EOF
CORE="$SELF_DIR/vdscreen-core"
NAME="iPad mini 7"
SIZE="1133x744"
EOF
    say "$CONFIG:"; say ""
    cat "$CONFIG"
    ;;
  set)
    key="${2:-}"; val="${3:-}"
    [[ -n "$key" && -n "$val" ]] || die "用法: vdscreen set <size|name|core> <值>"
    mkdir -p "$CONFIG_DIR"
    [[ -f "$CONFIG" ]] || cat > "$CONFIG" <<EOF
CORE="$CORE"
NAME="$NAME"
SIZE="$SIZE"
EOF
    case "$key" in
      size) SIZE="$val" ;;
      name) NAME="$val" ;;
      core) CORE="$val" ;;
      *) die "只支持 size / name / core" ;;
    esac
    # 重写配置（保留 LABEL，否则自定义标签会被悄悄丢掉）
    { [[ -n "$LABEL_FROM_CONFIG" ]] && echo "LABEL=\"$LABEL\""; echo "CORE=\"$CORE\""; echo "NAME=\"$NAME\""; echo "SIZE=\"$SIZE\""; } > "$CONFIG"
    say "已更新 $key = $val"
    loaded && say "（正在运行，执行 vdscreen restart 生效）"
    ;;
  install)
    [[ -x "$CORE" ]] || { say "先编译核心…"; "$SELF_DIR/build.sh"; }
    mkdir -p "$CONFIG_DIR"
    { [[ -n "$LABEL_FROM_CONFIG" ]] && echo "LABEL=\"$LABEL\""; echo "CORE=\"$SELF_DIR/vdscreen-core\""; echo "NAME=\"$NAME\""; echo "SIZE=\"$SIZE\""; } > "$CONFIG"
    mkdir -p "$HOME/bin"
    cp "$SELF_DIR/vdscreen" "$HOME/bin/vdscreen"
    chmod +x "$HOME/bin/vdscreen"
    say "已安装: ~/bin/vdscreen"
    case ":$PATH:" in
      *":$HOME/bin:"*) say "现在可以直接用: vdscreen status" ;;
      *) say "注意: ~/bin 不在 PATH 中，请把它加进 PATH" ;;
    esac
    ;;
  uninstall)
    "$0" off >/dev/null 2>&1 || true
    rm -f "$HOME/bin/vdscreen" "$HOME/bin/vdscreen-core"
    say "已卸载命令（保留 $CONFIG 与仓库目录）"
    ;;
  help|-h|--help)
    awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
    ;;
  *) die "未知命令: $1（试试 vdscreen help）" ;;
esac
